{
  "name": "harem-altin-api",
  "version": "0.1.1",
  "description": "Harem Altın API için resmi Pixcharp JavaScript/TypeScript istemcisi: canlı altın ve döviz alış-satış fiyatları, REST ve WebSocket. Official client for the Pixcharp Harem gold price API.",
  "keywords": [
    "harem",
    "harem-altin",
    "harem-api",
    "harem-altin-api",
    "altin",
    "altin-fiyatlari",
    "altin-api",
    "canli-altin",
    "gold-price",
    "gold-api",
    "doviz",
    "kuyumcu",
    "turkey",
    "websocket",
    "pixcharp"
  ],
  "homepage": "https://pixcharp.com/tr/harem-altin-api",
  "bugs": {
    "url": "https://github.com/Baristopal/harem-altin-api/issues",
    "email": "hello@pixcharp.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Baristopal/harem-altin-api.git"
  },
  "license": "MIT",
  "author": "Pixcharp <hello@pixcharp.com>",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
